{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/please-behave/cli/knowledge/contracts/configuration/rule.schema.json",
  "title": "Governance Rule definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_-]+$",
      "not": {
        "pattern": "^please-"
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^\\S([\\s\\S]*\\S)?$",
      "not": {
        "pattern": "[\u0000-\u001f\u007f-\u009f]"
      },
      "default": null
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "not": {
        "pattern": "\u0000"
      }
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "blocking": {
      "type": "boolean",
      "default": true
    },
    "run_at": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": null
    },
    "parameters": {
      "$ref": "parameters.schema.json",
      "default": {}
    },
    "check": {
      "$ref": "#/$defs/check",
      "default": null
    },
    "review": {
      "$ref": "#/$defs/review",
      "default": null
    }
  },
  "oneOf": [
    {
      "required": [
        "check"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "review"
            ]
          },
          {
            "required": [
              "blocking"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "review"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "check"
            ]
          },
          {
            "required": [
              "depends_on"
            ]
          }
        ]
      }
    }
  ],
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "default": 30
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "default": null
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "default": null
        },
        "include_content": {
          "type": "boolean",
          "default": true
        },
        "include_change_set": {
          "type": "boolean",
          "default": false
        },
        "parameters": {
          "type": "object",
          "default": {}
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "changed_files"
          ],
          "properties": {
            "changed_files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "default": null
        },
        "context": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "headings": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            }
          },
          "default": []
        }
      }
    }
  }
}
