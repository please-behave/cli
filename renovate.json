{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "extends": [
    "config:best-practices",
    "github>christianpflugradt/please-behave-governance:renovate-governor"
  ],
  "platformAutomerge": false,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "packageRules": [
    {
      "description": "Keep Rust 1.85.0 as the fixed minimum supported version; only the primary toolchain pin is updated.",
      "matchPackageNames": [
        "rust"
      ],
      "matchCurrentVersion": "1.85.0",
      "enabled": false
    },
    {
      "description": "Update the semantic-release changelog stack together so its preset and writer remain compatible.",
      "groupName": "semantic-release toolchain",
      "matchPackageNames": [
        "semantic-release",
        "@semantic-release/commit-analyzer",
        "@semantic-release/github",
        "@semantic-release/release-notes-generator",
        "conventional-changelog-conventionalcommits"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "14 days",
      "matchPackageNames": [
        "!please-behave/cli"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    }
  ]
}
