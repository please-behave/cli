    "x86_64-unknown-linux-gnu": [
      "please-v{version}-x86_64-unknown-linux-gnu.tar.gz",
      "metadata/x86_64-unknown-linux-gnu.json",
      "smoke/x86_64-unknown-linux-gnu.json"
    ],
    "aarch64-unknown-linux-gnu": [
      "please-v{version}-aarch64-unknown-linux-gnu.tar.gz",
      "metadata/aarch64-unknown-linux-gnu.json",
      "smoke/aarch64-unknown-linux-gnu.json"
    ]
