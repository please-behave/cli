{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API contract index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "contracts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^API-[0-9]{4}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "document",
          "requirements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CON-[0-9]{4}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "document": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*(/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
          },
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*(/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{4}$"
            }
          }
        }
      }
    }
  }
}
