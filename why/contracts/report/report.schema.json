{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/please-behave/cli/why/contracts/report/report.schema.json",
  "title": "Please Behave saved report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timestamp",
    "repository",
    "project",
    "overall",
    "snapshot",
    "results",
    "git_summary",
    "max_display_files",
    "plan"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "overall": {
      "enum": [
        "PASS",
        "FAIL",
        "ERROR"
      ]
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "git_summary": {
      "type": "string"
    },
    "max_display_files": {
      "type": "integer",
      "minimum": 0
    },
    "token_usage": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        {
          "type": "null"
        }
      ]
    },
    "adapter_usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/usage"
        },
        {
          "type": "null"
        }
      ]
    },
    "checks_only": {
      "type": "boolean"
    },
    "plan": {
      "$ref": "../plan/plan.schema.json#/$defs/prepared"
    }
  },
  "$defs": {
    "fileState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "bytes",
        "executable"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "executable": {
          "type": "boolean"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "fingerprint",
        "files",
        "complete",
        "limitations"
      ],
      "properties": {
        "head": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "fingerprint": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "maxProperties": 100000,
          "additionalProperties": {
            "$ref": "#/$defs/fileState"
          }
        },
        "complete": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "total_bytes",
        "truncated"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "cached_input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoning_output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "cache_write_input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "status",
        "blocking",
        "duration_ms",
        "reason",
        "findings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "check",
            "review",
            "integrity"
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "ERROR",
            "NOT_RUN",
            "CANCELLED"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "configuration_error": {
          "type": "boolean"
        },
        "blocked_by": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string"
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "stdout": {
          "anyOf": [
            {
              "$ref": "#/$defs/capture"
            },
            {
              "type": "null"
            }
          ]
        },
        "stderr": {
          "anyOf": [
            {
              "$ref": "#/$defs/capture"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
